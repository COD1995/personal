---
layout: default
---
{%- comment -%}
  Lecture notes for a course module (currently EAS 510 Basics of AI).
  Front matter: title, module ("00"…"09"), description, objectives (list), math (true to load MathJax).
  Module order, weeks, reading links, and previous/next come from _data/aibasic.yml.
{%- endcomment -%}
{%- assign course = site.data.aibasic.course -%}
{%- assign mods = site.data.aibasic.modules -%}
{%- assign idx = -1 -%}
{%- for m in mods -%}{%- if m.num == page.module -%}{%- assign idx = forloop.index0 -%}{%- assign cur = m -%}{%- endif -%}{%- endfor -%}
{%- assign prev_i = idx | minus: 1 -%}
{%- assign next_i = idx | plus: 1 -%}
{%- if idx > 0 -%}{%- assign prev = mods[prev_i] -%}{%- endif -%}
{%- if next_i < mods.size -%}{%- assign next = mods[next_i] -%}{%- endif -%}
<article class="page wrap lec">
  <div class="page-main" id="lec-top">
    <a class="back-link" href="{{ course.url | relative_url }}">← {{ course.code }} · {{ course.short }}</a>

    <header class="page-header lec-header">
      <p class="eyebrow">{{ course.code }} · Module {{ page.module }}{% if cur.weeks %} · {{ cur.weeks }}{% endif %}</p>
      <h1>{{ page.title }}</h1>
      {% if page.description %}<p class="page-description">{{ page.description }}</p>{% endif %}
      {% if cur.reading %}
      <p class="lec-reading">Companion reading: <a href="{{ cur.reading }}" rel="noopener">Learn PyTorch for Deep Learning, chapter {{ cur.num }}</a></p>
      {% endif %}
    </header>

    {% if page.objectives %}
    <section class="lec-goals" aria-label="Learning objectives">
      <p class="lec-goals-title">By the end of this module you can</p>
      <ol>
        {% for o in page.objectives %}<li>{{ o | markdownify | remove: '<p>' | remove: '</p>' | strip }}</li>{% endfor %}
      </ol>
    </section>
    {% endif %}

    <details class="lec-toc-mobile" hidden>
      <summary><span class="lec-toc-mobile-label">Contents</span><span class="lec-toc-mobile-current"></span></summary>
      <ol class="lec-toc-list"></ol>
    </details>

    <div class="page-body">
      {{ content }}
    </div>

    <nav class="lec-pager" aria-label="Modules">
      {% if prev %}
      <a class="lec-pager-prev" href="{{ course.url | append: prev.slug | append: '/' | relative_url }}"><span>← Module {{ prev.num }}{% if prev.weeks %} · {{ prev.weeks }}{% endif %}</span>{{ prev.title }}</a>
      {% else %}<span></span>{% endif %}
      {% if next %}
      <a class="lec-pager-next" href="{{ course.url | append: next.slug | append: '/' | relative_url }}"><span>Module {{ next.num }}{% if next.weeks %} · {{ next.weeks }}{% endif %} →</span>{{ next.title }}</a>
      {% endif %}
    </nav>

    <p class="lec-credit">
      These notes follow the path of Daniel Bourke's
      <a href="https://www.learnpytorch.io/" rel="noopener">Learn PyTorch for Deep Learning</a>
      (<a href="https://github.com/mrdbourke/pytorch-deep-learning" rel="noopener">MIT license</a>),
      rewritten for engineering students meeting Python and machine learning for the first time.
    </p>
  </div>

  <aside class="lec-toc" aria-label="On this page" hidden>
    <p class="lec-toc-title">On this page</p>
    <ol class="lec-toc-list"></ol>
    <a class="lec-toc-top" href="#lec-top">↑ Back to top</a>
  </aside>
</article>

<script>
/* Heading tracker: builds the "On this page" list from the note's h2/h3 headings
   (sidebar on wide screens, a sticky "Contents" drop-down on narrow ones) and
   highlights the section you are reading. */
(function () {
  var body = document.querySelector(".lec .page-body");
  if (!body) return;
  var heads = Array.prototype.slice.call(body.querySelectorAll("h2[id], h3[id]"));
  if (heads.length < 2) return;
  var aside = document.querySelector(".lec-toc");
  var mobile = document.querySelector(".lec-toc-mobile");
  var current = mobile.querySelector(".lec-toc-mobile-current");
  var links = [];
  var items = {};       // h2 index -> its <li> in the sidebar and in the drop-down
  var userOpen = {};    // sections the reader expanded with the arrow
  var userClosed = {};  // sections the reader collapsed with the arrow
  var sec = -1;         // index of the h2 section being read

  function build(list) {
    var ol = null;
    heads.forEach(function (h, i) {
      var li = document.createElement("li");
      var a = document.createElement("a");
      a.href = "#" + h.id;
      a.textContent = h.textContent;
      a.dataset.i = i;
      li.appendChild(a);
      if (h.tagName === "H2") {
        list.appendChild(li);
        ol = document.createElement("ol");
        li.appendChild(ol);
      } else if (ol) {
        ol.appendChild(li);
      } else {
        list.appendChild(li);
      }
      links.push(a);
    });
    list.querySelectorAll("ol:empty").forEach(function (e) { e.remove(); });
    // h2 entries with subheadings get an arrow button that shows/hides them
    list.querySelectorAll(":scope > li").forEach(function (li) {
      var sub = li.querySelector("ol");
      if (!sub) return;
      var a = li.querySelector("a");
      var i = +a.dataset.i;
      li.classList.add("has-sub");
      var btn = document.createElement("button");
      btn.type = "button";
      btn.className = "lec-toc-toggle";
      btn.setAttribute("aria-label", "Show subtopics of " + a.textContent);
      btn.setAttribute("aria-expanded", "false");
      btn.dataset.i = i;
      li.insertBefore(btn, sub);
      (items[i] = items[i] || []).push(li);
    });
  }
  build(aside.querySelector(".lec-toc-list"));
  build(mobile.querySelector(".lec-toc-list"));
  aside.hidden = false;
  mobile.hidden = false;
  document.querySelector(".lec").classList.add("has-toc");
  mobile.addEventListener("click", function (e) {
    if (e.target.tagName === "A") mobile.open = false;
  });

  // A section is expanded if the reader opened it, or if it is the one being read
  // (unless the reader collapsed it).
  function refresh() {
    Object.keys(items).forEach(function (k) {
      var i = +k;
      var open = !!userOpen[i] || (i === sec && !userClosed[i]);
      items[k].forEach(function (li) {
        li.classList.toggle("open", open);
        li.querySelector(".lec-toc-toggle").setAttribute("aria-expanded", open ? "true" : "false");
      });
    });
  }
  document.addEventListener("click", function (e) {
    var btn = e.target.closest && e.target.closest(".lec-toc-toggle");
    if (!btn) return;
    e.preventDefault();
    var i = +btn.dataset.i;
    var isOpen = btn.getAttribute("aria-expanded") === "true";
    if (isOpen) { userClosed[i] = true; delete userOpen[i]; }
    else { userOpen[i] = true; delete userClosed[i]; }
    refresh();
    edges();
    rail();
  });

  var active = -1, ticking = false;
  function update() {
    ticking = false;
    var idx = 0;
    for (var i = 0; i < heads.length; i++) {
      if (heads[i].getBoundingClientRect().top - line <= 0) idx = i; else break;
    }
    if (idx === active) return;
    active = idx;
    var s2 = idx;  // the h2 that contains the active heading
    while (s2 > 0 && heads[s2].tagName !== "H2") s2--;
    if (s2 !== sec) { delete userClosed[sec]; sec = s2; }  // a collapse lasts until you leave that section
    links.forEach(function (a) {
      a.classList.toggle("active", +a.dataset.i === idx);
    });
    refresh();
    edges();
    rail();
    current.textContent = heads[sec].textContent;
    var act = aside.querySelector("a.active");
    if (act && aside.scrollHeight > aside.clientHeight) {
      var r = act.getBoundingClientRect(), ar = aside.getBoundingClientRect();
      if (r.top < ar.top + 40 || r.bottom > ar.bottom - 40) aside.scrollTop += r.top - ar.top - ar.height / 3;
    }
  }
  window.addEventListener("scroll", function () {
    if (!ticking) { ticking = true; requestAnimationFrame(update); }
  }, { passive: true });

  // fade the sidebar's top/bottom edge when part of the list is scrolled out of view
  // move the rail's navy segment and dot to the active entry
  var railList = aside.querySelector(".lec-toc-list");
  function rail() {
    var act = railList.querySelector("a.active");
    if (!act || !aside.offsetParent) return;
    var lr = railList.getBoundingClientRect(), r = act.getBoundingClientRect();
    railList.style.setProperty("--rail", Math.round(r.top - lr.top + r.height / 2) + "px");
    railList.classList.add("has-rail");
  }
  function edges() {
    var more = aside.scrollHeight - aside.clientHeight > 2;
    aside.classList.toggle("more-above", more && aside.scrollTop > 2);
    aside.classList.toggle("more-below", more && aside.scrollTop + aside.clientHeight < aside.scrollHeight - 2);
  }
  aside.addEventListener("scroll", edges, { passive: true });
  var line = 110;  // a heading counts as "current" once it scrolls above this line
  function stickBelowHeader() {  // the site header is taller on phones (two rows)
    var h = document.querySelector(".site-header");
    var hh = h ? h.offsetHeight : 0;
    mobile.style.top = hh + "px";
    // keep headings reached from a link clear of the header and the Contents bar
    var bar = mobile.offsetParent ? mobile.querySelector("summary").offsetHeight : 0;
    var offset = hh + bar + 16;
    document.documentElement.style.scrollPaddingTop = offset + "px";
    line = offset + 10;
  }
  window.addEventListener("resize", function () { stickBelowHeader(); update(); rail(); });
  stickBelowHeader();
  update();
})();
</script>
