---
layout: default
---
<section class="home wrap">
  <div class="hero">
    <div class="hero-text">
      <div class="hero-name-row">
        <h1>{{ page.title | default: site.author.name }}</h1>
        <ul class="hero-links" aria-label="Profile links">
          <li>
            <a href="{{ '/assets/pdf/cv.pdf' | relative_url }}" aria-label="CV" title="CV">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="5" width="20" height="14" rx="2"/>
                <circle cx="8.5" cy="11" r="2"/>
                <path d="M5 16.5c0-1.5 1.2-2.5 3.5-2.5s3.5 1 3.5 2.5"/>
                <line x1="14" y1="10" x2="19" y2="10"/>
                <line x1="14" y1="14" x2="18" y2="14"/>
              </svg>
            </a>
          </li>
          <li>
            <a href="mailto:{{ site.author.email }}" aria-label="Email" title="Email">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/>
                <polyline points="22 6 12 13 2 6"/>
              </svg>
            </a>
          </li>
          <li>
            <a href="https://github.com/{{ site.author.github }}" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
              </svg>
            </a>
          </li>
        </ul>
      </div>
      {% if page.subtitle %}<p class="hero-subtitle">{{ page.subtitle }}</p>{% endif %}
      {% if page.profile.more_info %}
        <div class="hero-meta">{{ page.profile.more_info }}</div>
      {% endif %}
    </div>
    {% if page.profile.image %}
      <img class="hero-photo" src="{{ '/assets/img/' | append: page.profile.image | relative_url }}" alt="{{ site.author.name }}">
    {% endif %}
  </div>
  <div class="bio">
    {{ content }}
  </div>
</section>
