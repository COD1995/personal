<section class="visitors">
  <header class="visitors-header">
    <h2 class="visitors-title">Visitors</h2>
    <p class="visitors-summary">
      <strong id="visitors-total">—</strong> views from
      <strong id="visitors-countries">—</strong> <span id="visitors-countries-label">countries</span><span class="visitors-updated" id="visitors-updated"></span>
    </p>
  </header>

  <div class="visitor-map-wrap">
    <svg id="visitor-map"
         viewBox="0 0 960 480"
         preserveAspectRatio="xMidYMid meet"
         role="img"
         aria-label="World map shaded by visitor counts"></svg>
    <div class="visitor-tooltip" id="visitor-tooltip" aria-hidden="true"></div>
  </div>

  <footer class="visitors-footer">
    <span class="visitor-legend" aria-hidden="true">
      <span>fewer</span>
      <span class="visitor-legend-bar"></span>
      <span>more</span>
    </span>
    <span class="visitors-note">
      Tracked via <a href="https://www.goatcounter.com/" target="_blank" rel="noopener">GoatCounter</a> — country-level, no cookies, refreshed daily.
    </span>
  </footer>
</section>

<script type="module">
  // Visits data is baked in at build time from _data/visits.json
  // (refreshed daily by .github/workflows/update-visits.yml).
  const VISITS = {{ site.data.visits | jsonify }};

  // ISO 3166-1 numeric (M49, used by world-atlas) → alpha-2 (used by GoatCounter).
  const N2A_RAW = "4=AF,8=AL,10=AQ,12=DZ,16=AS,20=AD,24=AO,28=AG,31=AZ,32=AR,36=AU,40=AT,44=BS,48=BH,50=BD,51=AM,52=BB,56=BE,60=BM,64=BT,68=BO,70=BA,72=BW,74=BV,76=BR,84=BZ,86=IO,90=SB,92=VG,96=BN,100=BG,104=MM,108=BI,112=BY,116=KH,120=CM,124=CA,132=CV,136=KY,140=CF,144=LK,148=TD,152=CL,156=CN,158=TW,162=CX,166=CC,170=CO,174=KM,175=YT,178=CG,180=CD,184=CK,188=CR,191=HR,192=CU,196=CY,203=CZ,204=BJ,208=DK,212=DM,214=DO,218=EC,222=SV,226=GQ,231=ET,232=ER,233=EE,234=FO,238=FK,239=GS,242=FJ,246=FI,248=AX,250=FR,254=GF,258=PF,260=TF,262=DJ,266=GA,268=GE,270=GM,275=PS,276=DE,288=GH,292=GI,296=KI,300=GR,304=GL,308=GD,312=GP,316=GU,320=GT,324=GN,328=GY,332=HT,334=HM,336=VA,340=HN,344=HK,348=HU,352=IS,356=IN,360=ID,364=IR,368=IQ,372=IE,376=IL,380=IT,384=CI,388=JM,392=JP,398=KZ,400=JO,404=KE,408=KP,410=KR,414=KW,417=KG,418=LA,422=LB,426=LS,428=LV,430=LR,434=LY,438=LI,440=LT,442=LU,446=MO,450=MG,454=MW,458=MY,462=MV,466=ML,470=MT,474=MQ,478=MR,480=MU,484=MX,492=MC,496=MN,498=MD,499=ME,500=MS,504=MA,508=MZ,512=OM,516=NA,520=NR,524=NP,528=NL,531=CW,533=AW,534=SX,535=BQ,540=NC,548=VU,554=NZ,558=NI,562=NE,566=NG,570=NU,574=NF,578=NO,580=MP,581=UM,583=FM,584=MH,585=PW,586=PK,591=PA,598=PG,600=PY,604=PE,608=PH,612=PN,616=PL,620=PT,624=GW,626=TL,630=PR,634=QA,638=RE,642=RO,643=RU,646=RW,652=BL,654=SH,659=KN,660=AI,662=LC,663=MF,666=PM,670=VC,674=SM,678=ST,682=SA,686=SN,688=RS,690=SC,694=SL,702=SG,703=SK,704=VN,705=SI,706=SO,710=ZA,716=ZW,724=ES,728=SS,729=SD,732=EH,740=SR,744=SJ,748=SZ,752=SE,756=CH,760=SY,762=TJ,764=TH,768=TG,772=TK,776=TO,780=TT,784=AE,788=TN,792=TR,795=TM,796=TC,798=TV,800=UG,804=UA,807=MK,818=EG,826=GB,831=GG,832=JE,833=IM,834=TZ,840=US,850=VI,854=BF,858=UY,860=UZ,862=VE,876=WF,882=WS,887=YE,894=ZM";
  const N2A = Object.fromEntries(N2A_RAW.split(",").map(s => s.split("=")));

  (async () => {
    const total  = VISITS.total || 0;
    const counts = VISITS.countries || {};
    const knownCountries = Object.keys(counts).length;

    document.getElementById("visitors-total").textContent = total.toLocaleString();
    document.getElementById("visitors-countries").textContent = knownCountries;
    document.getElementById("visitors-countries-label").textContent =
      knownCountries === 1 ? "country" : "countries";
    if (VISITS.updated) {
      const d = new Date(VISITS.updated);
      if (!isNaN(d)) {
        document.getElementById("visitors-updated").textContent =
          " · updated " + d.toISOString().slice(0, 10);
      }
    }

    const svg = document.getElementById("visitor-map");
    let geo, topo, world;
    try {
      [geo, topo, world] = await Promise.all([
        import("https://cdn.jsdelivr.net/npm/d3-geo@3/+esm"),
        import("https://cdn.jsdelivr.net/npm/topojson-client@3/+esm"),
        fetch("https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json").then(r => {
          if (!r.ok) throw new Error("world-atlas fetch " + r.status);
          return r.json();
        })
      ]);
    } catch (err) {
      svg.outerHTML = '<p class="visitors-error">Map failed to load.</p>';
      console.error("[visitor-map]", err);
      return;
    }

    const W = 960, H = 480;
    const land = topo.feature(world, world.objects.countries);
    const projection = geo.geoNaturalEarth1().fitSize([W, H], land);
    const path = geo.geoPath(projection);

    // Choropleth: square-root scale so a heavy long tail still differentiates.
    const max = Math.max(0, ...Object.values(counts));
    const BG = [251, 250, 247];     // --bg #fbfaf7
    const FG = [139, 58, 58];       // --accent #8b3a3a
    const fillFor = (c) => {
      if (!c || max <= 0) return null;
      const t = Math.sqrt(c / max);
      const mix = (a, b) => Math.round(a + (b - a) * t);
      return `rgb(${mix(BG[0],FG[0])},${mix(BG[1],FG[1])},${mix(BG[2],FG[2])})`;
    };

    const NS = "http://www.w3.org/2000/svg";
    const frag = document.createDocumentFragment();
    for (const f of land.features) {
      const iso2  = N2A[f.id];
      const count = (iso2 && counts[iso2]) || 0;
      const d     = path(f);
      if (!d) continue;
      const p = document.createElementNS(NS, "path");
      p.setAttribute("d", d);
      const fill = fillFor(count);
      if (fill) p.setAttribute("fill", fill);
      p.setAttribute("class", count > 0 ? "country has-data" : "country");
      p.dataset.name  = f.properties.name;
      p.dataset.count = String(count);
      frag.appendChild(p);
    }
    svg.appendChild(frag);

    // Tooltip handling — single delegated listener.
    const tooltip = document.getElementById("visitor-tooltip");
    const wrap    = svg.parentElement;
    function position(e) {
      const r = wrap.getBoundingClientRect();
      tooltip.style.left = (e.clientX - r.left + 14) + "px";
      tooltip.style.top  = (e.clientY - r.top  + 14) + "px";
    }
    svg.addEventListener("mouseover", (e) => {
      if (e.target.tagName !== "path") return;
      const name  = e.target.dataset.name;
      const count = parseInt(e.target.dataset.count, 10) || 0;
      tooltip.textContent = count > 0
        ? `${name}: ${count.toLocaleString()} ${count === 1 ? "view" : "views"}`
        : name;
      tooltip.removeAttribute("aria-hidden");
      tooltip.classList.add("visible");
      e.target.classList.add("hover");
      position(e);
    });
    svg.addEventListener("mousemove", (e) => {
      if (e.target.tagName === "path") position(e);
    });
    svg.addEventListener("mouseout", (e) => {
      if (e.target.tagName !== "path") return;
      e.target.classList.remove("hover");
      tooltip.classList.remove("visible");
      tooltip.setAttribute("aria-hidden", "true");
    });
  })();
</script>
