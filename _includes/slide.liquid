{%- comment -%}
Slide deck — drag the slider to navigate. Arrow keys also work.
{%- endcomment -%}
{%- assign folder = include.folder -%}
{%- unless folder | slice: 0, 1 == '/' -%}
  {%- assign folder = '/' | append: folder -%}
{%- endunless -%}
{%- unless folder | slice: -1, 1 == '/' -%}
  {%- assign folder = folder | append: '/' -%}
{%- endunless -%}
{%- assign all = site.static_files | sort: 'path' -%}
{%- assign idx = 0 -%}
<div class="slide-deck" tabindex="0">
  <div class="slide-stage">
    {%- for f in all -%}
      {%- if f.path contains folder -%}
        {%- assign ext = f.extname | downcase -%}
        {%- if ext == '.png' or ext == '.jpg' or ext == '.jpeg' -%}
          {%- assign idx = idx | plus: 1 -%}
          {%- if idx == 1 -%}
            <img class="slide active" src="{{ f.path | relative_url }}" alt="Slide {{ idx }}">
          {%- else -%}
            <img class="slide" data-src="{{ f.path | relative_url }}" alt="Slide {{ idx }}">
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    <div class="slide-hint slide-hint-left" aria-hidden="true"><span>‹</span></div>
    <div class="slide-hint slide-hint-right" aria-hidden="true"><span>›</span></div>
  </div>
  <div class="slide-meta">
    <input class="slide-slider" type="range" min="1" max="{{ idx }}" value="1" step="1" aria-label="Jump to slide">
    <span class="slide-counter"><span class="slide-current">1</span> <span class="slide-sep">/</span> <span class="slide-total">{{ idx }}</span></span>
  </div>
</div>
<script>
(function () {
  document.querySelectorAll('.slide-deck').forEach(function (deck) {
    var slides = Array.prototype.slice.call(deck.querySelectorAll('.slide'));
    if (!slides.length) return;
    var total = slides.length;
    var counter = deck.querySelector('.slide-current');
    var slider = deck.querySelector('.slide-slider');
    var i = 0;

    function ensureLoaded(slide) {
      if (slide && !slide.src && slide.dataset.src) slide.src = slide.dataset.src;
    }
    function show(n) {
      i = Math.max(0, Math.min(total - 1, n));
      slides.forEach(function (s, j) { s.classList.toggle('active', j === i); });
      for (var k = -2; k <= 2; k++) {
        var t = i + k;
        if (t >= 0 && t < total) ensureLoaded(slides[t]);
      }
      if (counter) counter.textContent = i + 1;
      if (slider && slider.value !== String(i + 1)) slider.value = String(i + 1);
    }

    if (slider) {
      slider.addEventListener('input', function () { show(parseInt(slider.value, 10) - 1); });
    }

    var stage = deck.querySelector('.slide-stage');
    stage.addEventListener('click', function (e) {
      var rect = stage.getBoundingClientRect();
      ((e.clientX - rect.left) < rect.width / 2) ? show(i - 1) : show(i + 1);
    });

    deck.addEventListener('keydown', function (e) {
      var t = e.target;
      if (t && t.tagName === 'INPUT') return;
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(i - 1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); show(i + 1); }
      else if (e.key === 'Home') { e.preventDefault(); show(0); }
      else if (e.key === 'End') { e.preventDefault(); show(total - 1); }
    });

    show(0);
  });
})();
</script>
