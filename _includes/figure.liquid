{%- comment -%}
Minimal figure include. Accepts: path, alt, caption, class, loading, id, figure_number.
External URLs (http(s)://) are passed through; relative paths get relative_url applied.
{%- endcomment -%}
{%- assign src = include.path -%}
{%- unless src contains '://' -%}
  {%- assign src = src | relative_url -%}
{%- endunless -%}
<figure class="figure {{ include.class }}"{% if include.id %} id="{{ include.id }}"{% endif %}>
  <img src="{{ src }}" alt="{{ include.alt | default: include.caption }}" loading="{{ include.loading | default: 'lazy' }}">
  {%- if include.caption -%}
    <figcaption>
      {%- if include.figure_number -%}<strong>Fig {{ include.figure_number }}.</strong> {% endif -%}
      {{ include.caption }}
    </figcaption>
  {%- endif -%}
</figure>
